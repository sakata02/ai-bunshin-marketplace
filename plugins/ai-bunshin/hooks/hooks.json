{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_py.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/update_dashboard.py\" --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_py.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/update_dashboard.py\" --session",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_py.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/conversation_index.py\" update --quiet",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run_py.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/ng_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
