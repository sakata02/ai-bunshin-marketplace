{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python || echo py)\" \"${CLAUDE_PLUGIN_ROOT}/scripts/update_dashboard.py\" --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python || echo py)\" \"${CLAUDE_PLUGIN_ROOT}/scripts/update_dashboard.py\" --session",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python3 || command -v python || echo py)\" \"${CLAUDE_PLUGIN_ROOT}/scripts/ng_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
